package mcode:feature-pack@0.0.1;

interface web-host {
    record typed-search {
        query: string,
        count: u8,
        range: search-range,
        chunks: u8,
        country: option<string>,
        language: option<string>,
        domains: list<string>,
    }

    enum search-range {
        none,
        d7,
        w2,
        m3,
        y1,
    }

    record typed-fetch {
        urls: list<string>,
        format: content-format,
        per-page-timeout: u8,
        metadata: bool,
    }

    enum content-format {
        markdown,
        text,
        html,
    }

    record web-head {
        status: u16,
        media: web-media,
    }

    enum web-media {
        json,
        event-stream,
        text,
        html,
    }

    record web-data {
        bytes: list<u8>,
    }

    variant web-frame {
        head(web-head),
        data(web-data),
        end,
    }

    variant web-exchange-pull {
        pending,
        frame(web-frame),
        failed(web-failure),
    }

    enum web-failure {
        dns,
        tls,
        timeout,
        truncated,
        transport,
        cancelled,
    }

    enum web-host-error {
        invalid-argument,
        authority-rejected,
        remote-unavailable,
        protocol,
        limit,
        cancelled,
    }

    resource web-exchange {
        pull: func() -> web-exchange-pull;
    }

    start-search: func(request: typed-search) -> result<own<web-exchange>, web-host-error>;
    start-fetch: func(request: typed-fetch) -> result<own<web-exchange>, web-host-error>;
}

interface web-pack {
    variant web-request {
        search(search-request),
        fetch(fetch-request),
    }

    record search-request {
        query: string,
        count: u8,
        range: search-range,
        chunks: u8,
        country: option<string>,
        language: option<string>,
        domains: list<string>,
    }

    enum search-range {
        none,
        d7,
        w2,
        m3,
        y1,
    }

    record fetch-request {
        urls: list<string>,
        format: content-format,
        per-page-timeout: u8,
        metadata: bool,
    }

    enum content-format {
        markdown,
        text,
        html,
    }

    variant web-progress {
        searching,
        fetching(fetch-progress),
    }

    variant web-pull {
        pending,
        progress(web-progress),
        complete(web-result),
        failed(web-error),
    }

    record fetch-progress {
        completed: u8,
        total: u8,
    }

    variant web-result {
        search-results(search-results),
        fetch-results(fetch-results),
    }

    record search-results {
        items: list<search-item>,
        truncated: bool,
    }

    record search-item {
        source-id: string,
        search-id: string,
        url: string,
        title: string,
        text: string,
        published: option<string>,
        truncated: bool,
    }

    record fetch-results {
        pages: list<fetch-page>,
        truncated: bool,
    }

    record fetch-page {
        source-id: string,
        search-id: option<string>,
        url: string,
        title: option<string>,
        text: string,
        published: option<string>,
        truncated: bool,
        original-bytes: option<u64>,
        returned-bytes: u64,
        returned-lines: u32,
    }

    enum web-error {
        invalid-argument,
        invalid-url,
        authority-rejected,
        remote-unavailable,
        protocol,
        limit,
        cancelled,
    }

    resource web-operation {
        pull: func() -> web-pull;
    }

    invoke: func(request: web-request) -> result<own<web-operation>, web-error>;
}

world web {
    import web-host;
    export web-pack;
}
