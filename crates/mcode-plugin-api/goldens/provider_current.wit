package mcode:provider-pack@0.0.1;

/// Sole current ProviderPack guest interface.
interface provider-api {
    /// A bounded provider identity projection.
    type provider-id = string;

    /// A bounded provider route identity projection.
    type provider-route-id = string;

    /// A bounded declarative completion operation identity.
    type provider-operation-id = string;

    /// A canonical provider catalog digest.
    type catalog-digest = string;

    /// A canonical digest of projected catalog metadata content.
    type catalog-content-digest = string;

    /// A canonical verified catalog metadata revision.
    record catalog-revision {
        /// Normalized Unix seconds from the sole verified revision time source.
        last-modified: u64,
        /// Host-computed canonical digest of the projected metadata content.
        canonical-content-digest: catalog-content-digest,
    }

    /// A bounded exact model identity.
    type model-id = string;

    /// A bounded model alias.
    type model-alias = string;

    /// A bounded request identity projection.
    type request-id = string;

    /// A bounded turn identity projection.
    type turn-id = string;

    /// A bounded image identity projection.
    type image-stamp = string;

    /// A bounded reasoning proof identity projection.
    type proof-stamp = string;

    /// Selects either an exact model or an alias.
    variant model-selection {
        /// Selects the exact model in the payload.
        exact(model-id),
        /// Selects the alias in the payload.
        alias(model-alias),
    }

    /// States whether a catalog capability is known and supported.
    enum capability-support {
        /// Signed metadata did not report this capability.
        unknown,
        /// The capability is explicitly unsupported.
        unsupported,
        /// The capability is explicitly supported.
        supported,
    }

    /// One accepted input modality.
    enum input-modality {
        /// Signed metadata did not report modalities.
        unknown,
        /// UTF-8 text input.
        text,
        /// Host-verified image input.
        image,
    }

    /// Tool and ToolChoice support for one model.
    record tool-capability {
        /// Whether tools are accepted.
        tools: capability-support,
        /// Whether automatic ToolChoice is accepted.
        auto-choice: capability-support,
        /// Whether no-tool ToolChoice is accepted.
        none-choice: capability-support,
        /// Whether named ToolChoice is accepted.
        specific-choice: capability-support,
    }

    /// Reasoning controls and proof support for one model.
    record reasoning-capability {
        /// Whether reasoning can be enabled.
        reasoning: capability-support,
        /// Whether effort controls are accepted.
        effort: capability-support,
        /// Whether token budgets are accepted.
        budget: capability-support,
        /// Whether sealed reasoning proofs are accepted.
        proof: capability-support,
    }

    /// Signed metadata allowed to replace one catalog entry's metadata.
    record catalog-metadata-entry {
        /// Existing catalog selection receiving replacement metadata.
        selection: model-selection,
        /// Optional human-facing model name.
        display-name: option<string>,
        /// Declaration-ordered unique replacement input modality set.
        /// The `unknown` case must be the sole item when present.
        input-modalities: list<input-modality>,
        /// Complete replacement tool capability.
        tool-capability: tool-capability,
        /// Complete replacement reasoning capability.
        reasoning-capability: reasoning-capability,
        /// Optional context token limit.
        context-tokens: option<u64>,
        /// Optional output token limit.
        max-output-tokens: option<u64>,
    }

    /// Verified catalog metadata supplied as bounded data.
    record catalog-metadata-view {
        /// Canonical revision of the complete metadata replacement.
        revision: catalog-revision,
        /// Selection-sorted replacement entries.
        entries: list<catalog-metadata-entry>,
    }

    /// Manifest-fixed source used to construct a catalog snapshot.
    variant catalog-source-view {
        /// Uses only catalog metadata embedded in the component.
        embedded,
        /// Uses separately verified replacement metadata.
        verified(catalog-metadata-view),
    }

    /// Requests the descriptor for one pre-bound provider route.
    record descriptor-request {
        /// Expected provider comparison value.
        provider-id: provider-id,
        /// Expected route comparison value.
        route-id: provider-route-id,
        /// Manifest-fixed catalog source data.
        catalog-source: catalog-source-view,
    }

    /// Describes one final immutable provider catalog snapshot.
    record provider-descriptor {
        /// Provider comparison value.
        provider-id: provider-id,
        /// Route comparison value.
        route-id: provider-route-id,
        /// Verified revision, absent for an embedded source.
        source-revision: option<catalog-revision>,
        /// Canonical final catalog digest.
        catalog-digest: catalog-digest,
        /// Exact number of model entries in the catalog.
        model-count: u32,
    }

    /// One model entry in the final catalog snapshot.
    record catalog-entry {
        /// Unique exact-or-alias selection.
        selection: model-selection,
        /// Exact current model selected by this entry.
        current-model: model-id,
        /// Optional human-facing model name.
        display-name: option<string>,
        /// Declaration-ordered unique accepted input modality set.
        /// The `unknown` case must be the sole item when present.
        input-modalities: list<input-modality>,
        /// Complete tool capability.
        tool-capability: tool-capability,
        /// Complete reasoning capability.
        reasoning-capability: reasoning-capability,
        /// Optional context token limit.
        context-tokens: option<u64>,
        /// Optional output token limit.
        max-output-tokens: option<u64>,
        /// Declarative completion operation for this model.
        completion-operation: provider-operation-id,
    }

    /// Requests one page from an immutable catalog snapshot.
    record catalog-request {
        /// Expected provider comparison value.
        provider-id: provider-id,
        /// Expected route comparison value.
        route-id: provider-route-id,
        /// Manifest-fixed catalog source data.
        catalog-source: catalog-source-view,
        /// Expected descriptor catalog digest.
        catalog-digest: catalog-digest,
        /// Zero-based entry offset.
        offset: u32,
        /// Maximum requested entries in this page.
        limit: u16,
    }

    /// One selection-sorted page from a catalog snapshot.
    record catalog-page {
        /// Provider comparison value.
        provider-id: provider-id,
        /// Route comparison value.
        route-id: provider-route-id,
        /// Verified revision, absent for an embedded source.
        source-revision: option<catalog-revision>,
        /// Descriptor catalog digest.
        catalog-digest: catalog-digest,
        /// Exact number of entries in the complete catalog.
        declared-count: u32,
        /// Offset used to produce this page.
        offset: u32,
        /// Selection-sorted page entries.
        entries: list<catalog-entry>,
        /// Strictly advancing offset when more entries remain.
        next-offset: option<u32>,
    }

    /// Requests presentation metadata for one pre-bound provider route.
    record auth-interaction-request {
        /// Expected provider comparison value.
        provider-id: provider-id,
        /// Expected route comparison value.
        route-id: provider-route-id,
    }

    /// Human-facing authentication setup instructions.
    record auth-instructions {
        /// Nonempty bounded presentation title.
        title: string,
        /// Ordered bounded presentation steps.
        steps: list<string>,
    }

    /// Authentication presentation metadata.
    variant auth-interaction-response {
        /// No presentation is needed for this route.
        not-required,
        /// Displays setup instructions without accepting answers.
        instructions(auth-instructions),
    }

    /// A sorted object member in a flat JSON document.
    record wire-json-field {
        /// Decoded bounded object key.
        key: string,
        /// Index of a previously declared value node.
        value: u32,
    }

    /// Child indices for one JSON array node.
    record wire-json-array {
        /// Ordered indices of previously declared child nodes.
        items: list<u32>,
    }

    /// Sorted fields for one JSON object node.
    record wire-json-object {
        /// UTF-8 byte-sorted unique object fields.
        fields: list<wire-json-field>,
    }

    /// One node in a flat postorder JSON tree.
    variant wire-json-node {
        /// JSON null.
        null-value,
        /// JSON boolean.
        boolean-value(bool),
        /// Canonical JSON number text.
        number-value(string),
        /// Decoded bounded JSON string.
        string-value(string),
        /// JSON array child indices.
        array-value(wire-json-array),
        /// JSON object fields.
        object-value(wire-json-object),
    }

    /// A flat typed postorder JSON tree.
    record wire-json-document {
        /// Index of the root node.
        root: u32,
        /// Postorder nodes with the root last.
        nodes: list<wire-json-node>,
    }

    /// Plain message text.
    record text-block {
        /// Nonempty bounded safe text.
        text: string,
    }

    /// Accepted encoded image media.
    enum image-media-type {
        /// PNG image bytes.
        png,
        /// JPEG image bytes.
        jpeg,
        /// GIF image bytes.
        gif,
        /// WebP image bytes.
        webp,
        /// TIFF image bytes.
        tiff,
    }

    /// Host-verified image metadata.
    record image-metadata {
        /// Positive pixel width.
        width: u32,
        /// Positive pixel height.
        height: u32,
        /// Positive frame count.
        frames: u32,
    }

    /// One immutable image byte view.
    record image-view {
        /// Host-resolved image identity projection.
        stamp: image-stamp,
        /// Exact image media type.
        media-type: image-media-type,
        /// Exact verified image bytes.
        bytes: list<u8>,
        /// Metadata verified against the bytes.
        metadata: image-metadata,
    }

    /// A normalized reasoning content kind.
    enum reasoning-kind {
        /// Model thinking text.
        thinking,
        /// Model reasoning summary text.
        summary,
    }

    /// One read-only sealed reasoning proof view.
    record reasoning-proof-view {
        /// Host-resolved proof identity projection.
        stamp: proof-stamp,
        /// Original request comparison value.
        source-request-id: request-id,
        /// Original turn comparison value.
        source-turn-id: turn-id,
        /// Original reasoning content index.
        source-content-index: u8,
        /// Original reasoning kind.
        reasoning-kind: reasoning-kind,
        /// Exact bounded proof bytes.
        proof: list<u8>,
    }

    /// Reasoning text with an optional sealed proof view.
    record reasoning-block {
        /// Reasoning content kind.
        kind: reasoning-kind,
        /// Nonempty bounded safe reasoning text.
        text: string,
        /// Optional same-context proof view.
        proof: option<reasoning-proof-view>,
    }

    /// One complete tool call in request history.
    record tool-call-block {
        /// Globally unique call identity.
        call-id: string,
        /// Globally unique input tool name.
        name: string,
        /// Complete object-rooted tool arguments.
        arguments: wire-json-document,
    }

    /// A block legal in a user message.
    variant user-block {
        /// Plain user text.
        text(text-block),
        /// Host-verified user image.
        image(image-view),
    }

    /// A block legal in an assistant message.
    variant assistant-block {
        /// Plain assistant text.
        text(text-block),
        /// Assistant reasoning text and optional proof.
        reasoning(reasoning-block),
        /// Complete assistant tool call.
        tool-call(tool-call-block),
    }

    /// A block legal in a tool result message.
    variant tool-result-block {
        /// Plain tool result text.
        text(text-block),
        /// Host-verified tool result image.
        image(image-view),
    }

    /// One nonempty user message.
    record user-message {
        /// Ordered role-legal blocks.
        blocks: list<user-block>,
    }

    /// One nonempty assistant message.
    record assistant-message {
        /// Ordered role-legal blocks.
        blocks: list<assistant-block>,
    }

    /// One nonempty result for a declared tool call.
    record tool-result-message {
        /// Declared call being answered.
        call-id: string,
        /// Ordered role-legal result blocks.
        blocks: list<tool-result-block>,
        /// Whether tool execution failed.
        is-error: bool,
    }

    /// One provider completion message.
    variant message {
        /// User-authored content.
        user(user-message),
        /// Assistant-authored content.
        assistant(assistant-message),
        /// Result for one assistant tool call.
        tool-result(tool-result-message),
    }

    /// One input tool definition.
    record tool-definition {
        /// Globally unique bounded tool name.
        name: string,
        /// Bounded safe tool description.
        description: string,
        /// Complete object-rooted input schema.
        input-schema: wire-json-document,
    }

    /// A named ToolChoice payload.
    record specific-tool-choice {
        /// Exact name of the sole selected input tool.
        name: string,
    }

    /// Tool selection semantics without implicit defaults.
    variant tool-choice {
        /// Omits every ToolChoice-related output path.
        unset,
        /// Permits the model to choose an input tool.
        auto,
        /// Requires no tool call.
        none,
        /// Requires the named sole input tool.
        specific(specific-tool-choice),
    }

    /// A provider-neutral reasoning effort.
    enum reasoning-effort {
        /// Minimal reasoning effort.
        minimal,
        /// Low reasoning effort.
        low,
        /// Medium reasoning effort.
        medium,
        /// High reasoning effort.
        high,
    }

    /// Explicit enabled reasoning controls.
    record enabled-reasoning {
        /// Optional exact effort.
        effort: option<reasoning-effort>,
        /// Optional positive token budget.
        budget-tokens: option<u64>,
    }

    /// Reasoning request semantics without implicit defaults.
    variant reasoning {
        /// Omits every reasoning-related output path.
        unset,
        /// Explicitly disables reasoning.
        disabled,
        /// Enables the exact supplied controls.
        enabled(enabled-reasoning),
    }

    /// Cache retention semantics without implicit defaults.
    variant cache-retention {
        /// Omits every cache-related output path.
        unset,
        /// Explicitly disables retention.
        none,
        /// Retains data only for this request scope.
        request,
        /// Retains data for the current session scope.
        session,
    }

    /// Complete provider-neutral completion input.
    record prepare-input {
        /// Expected provider comparison value.
        provider-id: provider-id,
        /// Expected route comparison value.
        route-id: provider-route-id,
        /// Immutable catalog snapshot digest.
        catalog-digest: catalog-digest,
        /// Exact requested model selection.
        selection: model-selection,
        /// Exact current model bound to the selection.
        current-model: model-id,
        /// Declarative completion operation.
        operation-id: provider-operation-id,
        /// Host-issued request comparison value.
        request-id: request-id,
        /// Host-issued turn comparison value.
        turn-id: turn-id,
        /// Ordered system prompt parts.
        system: list<string>,
        /// Ordered complete request messages.
        messages: list<message>,
        /// Ordered unique input tools.
        tools: list<tool-definition>,
        /// Exact ToolChoice semantics.
        tool-choice: tool-choice,
        /// Exact reasoning semantics.
        reasoning: reasoning,
        /// Exact cache retention semantics.
        cache-retention: cache-retention,
        /// Optional requested output token limit.
        max-output-tokens: option<u64>,
    }

    /// One ordinary non-reserved request header.
    record ordinary-header {
        /// Canonical lowercase header name.
        name: string,
        /// Bounded visible ASCII header value.
        value: string,
    }

    /// Prepared body and ordinary headers.
    record prepared-request {
        /// Typed object-rooted request body.
        body: wire-json-document,
        /// Canonically sorted unique ordinary headers.
        ordinary-headers: list<ordinary-header>,
    }

    /// Supported decoded response media.
    enum response-media {
        /// One JSON response document.
        json,
        /// An event stream response.
        event-stream,
    }

    /// One bounded response head.
    record response-head {
        /// HTTP status in the inclusive range 200 through 599.
        status: u16,
        /// Validated response media.
        media: response-media,
    }

    /// One bounded response frame.
    variant response-frame {
        /// The sole response head.
        head(response-head),
        /// One nonempty decoded data chunk.
        data(list<u8>),
        /// The sole response end marker.
        end,
    }

    /// One normalized text delta.
    record text-delta {
        /// Contiguous content index.
        content-index: u8,
        /// Nonempty bounded safe text.
        text: string,
    }

    /// One normalized reasoning delta.
    record reasoning-delta {
        /// Contiguous content index.
        content-index: u8,
        /// Reasoning content kind.
        kind: reasoning-kind,
        /// Nonempty bounded safe reasoning text.
        text: string,
    }

    /// One normalized reasoning proof.
    record reasoning-proof {
        /// Current reasoning content index.
        content-index: u8,
        /// Current reasoning content kind.
        kind: reasoning-kind,
        /// Nonempty bounded proof bytes.
        proof: list<u8>,
    }

    /// Starts one normalized tool call.
    record tool-call-start {
        /// Contiguous tool content index.
        content-index: u8,
        /// Globally unique call identity.
        call-id: string,
        /// Exact input tool name.
        name: string,
    }

    /// Adds one normalized tool argument fragment.
    record tool-arguments-delta {
        /// Current tool content index.
        content-index: u8,
        /// Current tool call identity.
        call-id: string,
        /// Nonempty bounded safe JSON text fragment.
        delta: string,
    }

    /// Ends one normalized tool call.
    record tool-call-end {
        /// Current tool content index.
        content-index: u8,
        /// Current tool call identity.
        call-id: string,
    }

    /// Why a successful completion stopped.
    enum completion-reason {
        /// Natural model stop.
        stop,
        /// One or more complete tool calls were produced.
        tool-use,
        /// The output token limit stopped generation.
        length,
    }

    /// Four independent optional usage counters.
    record usage {
        /// Exact reported input tokens.
        input-tokens: option<u64>,
        /// Exact reported output tokens.
        output-tokens: option<u64>,
        /// Exact reported cache-read tokens.
        cache-read-tokens: option<u64>,
        /// Exact reported cache-write tokens.
        cache-write-tokens: option<u64>,
    }

    /// One successful normalized terminal.
    record completion-terminal {
        /// Exact normalized stop reason.
        reason: completion-reason,
        /// Optional validated reported model.
        reported-model: option<model-id>,
        /// Independent exact optional usage counters.
        usage: usage,
    }

    /// A stable unsupported provider flow.
    enum unsupported-flow {
        /// Catalog source cannot be represented.
        catalog-source,
        /// Authentication presentation cannot be represented.
        authentication,
        /// Model selection cannot be represented.
        model,
        /// Tool definitions cannot be represented.
        tools,
        /// ToolChoice cannot be represented.
        tool-choice,
        /// Reasoning controls cannot be represented.
        reasoning,
        /// Cache retention cannot be represented.
        cache,
        /// Image input cannot be represented.
        image,
        /// Reasoning proof cannot be represented.
        proof,
        /// Response media cannot be represented.
        response-media,
    }

    /// Stable non-sensitive ProviderPack failure.
    variant provider-error {
        /// A bounded value is malformed or inconsistent.
        invalid-argument,
        /// A semantic or logical-size bound was exceeded.
        limit,
        /// A closed provider flow is unsupported.
        unsupported-flow(unsupported-flow),
        /// Required provider functionality is unavailable.
        unavailable,
        /// The operation was cancelled.
        cancelled,
        /// A stable provider failure occurred.
        failed,
    }

    /// One normalized decoder event.
    variant normalized-event {
        /// Incremental user-visible text.
        text-delta(text-delta),
        /// Incremental reasoning text.
        reasoning-delta(reasoning-delta),
        /// One proof for the current reasoning index.
        reasoning-proof(reasoning-proof),
        /// Start of one tool call.
        tool-call-start(tool-call-start),
        /// Incremental tool argument JSON text.
        tool-arguments-delta(tool-arguments-delta),
        /// End of one complete tool call.
        tool-call-end(tool-call-end),
        /// The sole successful terminal.
        completed(completion-terminal),
        /// The sole stable failed terminal.
        failed(provider-error),
    }

    /// Decoder output with no observable post-terminal state.
    variant decoder-pull {
        /// One nonempty bounded event batch.
        events(list<normalized-event>),
        /// Requests exactly one next response frame.
        need-frame,
    }

    /// Explicit acknowledgement of an accepted response frame.
    enum frame-acceptance {
        /// The frame was accepted into decoder state.
        accepted,
    }

    /// Guest-defined incremental response decoder.
    resource response-decoder {
        /// Pulls up to the explicitly labeled event limit.
        pull: func(limit: u8) -> result<decoder-pull, provider-error>;

        /// Pushes one frame only after a need-frame pull.
        push: func(frame: response-frame) -> result<frame-acceptance, provider-error>;
    }

    /// Prepared request paired with its guest-defined decoder.
    record prepared-completion {
        /// Validated typed body and ordinary headers.
        request: prepared-request,
        /// Newly owned decoder for this response.
        decoder: own<response-decoder>,
    }

    /// Returns one immutable route descriptor.
    descriptor: func(request: descriptor-request) -> result<provider-descriptor, provider-error>;

    /// Returns one page from the descriptor's immutable catalog.
    catalog: func(request: catalog-request) -> result<catalog-page, provider-error>;

    /// Returns authentication presentation metadata only.
    auth-interaction: func(request: auth-interaction-request) -> result<auth-interaction-response, provider-error>;

    /// Prepares one completion request and guest-defined decoder.
    prepare-request: func(input: prepare-input) -> result<prepared-completion, provider-error>;
}

/// Sole current ProviderPack world.
world provider {
    export provider-api;
}
