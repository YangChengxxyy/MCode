{"rule":"topology","package":"mcode:feature-pack@0.0.1","world":"mcode:feature-pack/compaction@0.0.1","import":"mcode:feature-pack/compaction-host@0.0.1","export":"mcode:feature-pack/compaction-pack@0.0.1","currentOnly":true,"familyLocalTypes":true}
{"rule":"operation-authority","cases":{"assess":{"operationId":"assess","hostMethods":[]},"summarize":{"operationId":"summarize","hostMethods":["summarize"]}},"bodyCarriesPackId":false,"bindingBeforeOperationAllocation":true}
{"rule":"table-authority","hostResolvesBeforePack":["session-id","branch-id","head event","item event-id","call-id"],"sameLedger":true,"sameBranchLineage":true,"sameRequestHead":true,"crossedFamilyOrRow":"reject before Pack, route, or effect","guestScalarGrantsAuthority":false}
{"rule":"scalar-grammar","sessionId":"ses1-[0-9a-f]{32}","sessionIdBytes":37,"branchId":"br1-[0-9a-f]{32}","branchIdBytes":36,"eventId":"evt1-[0-9a-f]{32}","eventIdBytes":37,"callId":"call1-[0-9a-f]{32}","callIdBytes":38,"headCases":["empty","event"],"decodedUtf8ExactBytes":true}
{"rule":"safe-text-and-charge","safeRejects":["CR","DEL","C0 except TAB and LF","C1","Bidi_Control"],"itemTextBytes":{"min":1,"max":1048576},"summaryTextBytes":{"min":0,"max":1048576},"totalItemTextBytesMax":8388608,"requestChargeMax":8388608,"checkedU64":true,"overflow":"limit"}
{"rule":"assessment-reducer","contextLimit":{"min":1,"max":9223372036854775807},"reserveOutput":{"min":0,"maxRelation":"context-limit"},"needed":"checked input-tokens + reserve-output > context-limit","notNeededTarget":0,"neededTarget":"min(1048576, context-limit - reserve-output)","zeroOrUnrepresentableDifference":"limit"}
{"rule":"summarize-input","items":{"min":1,"max":2048,"order":"branch ledger order","eventIdUnique":true},"targetTokens":{"min":1,"max":1048576},"nonToolCallId":"none"}
{"rule":"tool-pairing","toolCall":"immediately followed by tool-result with identical call-id","reject":["orphan","crossed","duplicate"],"otherKindsCallId":"none"}
{"rule":"progress-reducer","assess":["assessing","validating"],"summarize":["validating","summarizing*"],"progressOptional":true,"summarizing":{"total":"items.length","totalMin":1,"totalMax":2048,"completed":"contiguous from 0 through total","duplicateSkipRollback":false}}
{"rule":"import-cardinality","assess":{"summarize":0,"success":"assessment"},"summarize":{"summarize":1,"success":"summary"},"duplicateImport":"reject before extra effect","afterFailureImports":0}
{"rule":"summary-output","coveredThrough":"exact last request item event-id and same-branch request-head ancestor","coveredThroughBytes":37,"textBytesMax":1048576,"counters":"none or some 0..9223372036854775807","terminal":"exact typed structural copy of accepted summary-output","mismatch":"reject without retain or publish","extraEffectAfterMismatch":0}
{"rule":"stable-errors","outer":["invalid-argument","stale-head","provider-unavailable","invalid-terminal","limit","cancelled","unavailable"],"invalidTerminalReasons":["length","error","cancel","tool-call"],"hostSameNameMapping":true,"rawSourceText":false}
{"rule":"boundary-coverage","dimensions":["0","1","N","N+1"],"requestProjections":["session-id","branch-id","head event","item event-id","call-id","items","item text","target-tokens","input-tokens","context-limit","reserve-output","aggregate charge"],"outputProjections":["summary text","covered-through","input-tokens option","output-tokens option"],"relations":["ledger","branch","head","call pairing","covered-through ancestor"],"utf8Boundary":"whole decoded scalar, never truncation"}
{"rule":"stage-scope","asserts":["source and golden equality","parseable typed surface","pure semantic authority projection"],"excludes":["runtime behavior","component binary preflight","network grant","real Provider effect"]}
