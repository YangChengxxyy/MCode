{"rule":"topology","package":"mcode:feature-pack@0.0.1","world":"mcode:feature-pack/workspace@0.0.1","import":"mcode:feature-pack/workspace-host@0.0.1","export":"mcode:feature-pack/workspace-pack@0.0.1","currentOnly":true,"familyLocalTypes":true}
{"rule":"operation-authority","cases":{"checkpoint":{"operationId":"checkpoint","hostMethods":["scan"]},"inspect":{"operationId":"inspect","hostMethods":["scan"]},"rollback":{"operationId":"rollback","hostMethods":["scan","apply-rollback"]}},"bindingBeforeOperationAllocation":true}
{"rule":"table-authority","checkpointId":{"issuer":"Host","grammar":"cp1-[0-9a-f]{32}"},"reservationId":{"issuer":"Host","grammar":"wsr1-[0-9a-f]{32}","singleUse":true},"fingerprint":"sha256:[0-9a-f]{64}","rowBinds":["caller family","Manager and Pack identity","generation","OperationId","outer task","checkpoint","expected-current fence"],"foreignStaleCrossed":"reject before effect","guestScalarGrantsAuthority":false}
{"rule":"workspace-path","kind":"family-local alias","utf8Bytes":{"min":1,"max":512},"components":{"min":1,"max":128},"reject":["NUL","control","Bidi_Control","empty component","dot","dot-dot","backslash","absolute root","drive","duplicate separator","trailing separator"],"canonicalRelative":true}
{"rule":"scalar-bounds","digest":"lowercase sha256 plus 64 lowercase hex","changeHash":"none or digest","snapshotCounts":{"min":0,"max":9223372036854775807},"scanOffset":{"min":0,"max":4294967295},"scanLimit":{"min":1,"max":256},"conflictPaths":{"min":0,"max":16,"order":"path bytes","unique":true}}
{"rule":"first-scan","inspect":"exact outer checkpoint-id, fingerprint, offset, and limit","checkpoint":{"checkpointId":"reservation.checkpoint-id","fingerprint":"reservation.expected-current","offset":0,"limit":256},"rollback":{"checkpointId":"outer.checkpoint-id","fingerprint":"outer.expected-current","offset":0,"limit":256},"rollbackOuterEqualsReservation":["checkpoint-id","expected-current"]}
{"rule":"scan-cursor","subsequentRequest":"same checkpoint-id, fingerprint, and limit; offset exact prior next","nonEofNext":"checked offset + items.length","strictForward":true,"eof":"none","reject":["empty plus some","stale","replay","skip","rollback"],"scanPullCap":65536,"rollbackScanMax":65535}
{"rule":"scan-page","items":"path byte-sorted unique","snapshot":"exact typed structural equality on every page","receiptBinds":["all pages","snapshot","fingerprint","reservation","expected-current"],"unsafeUnrollbackableMissingOrCrossed":"invalid receipt"}
{"rule":"invalid-page-effects","observedScans":"exact count needed to observe invalid page","laterScans":0,"applyRollback":0,"durableWorkspaceMutation":false,"preImportBindingRejectionScans":0,"doesNotClaimObservedScanWasZero":true}
{"rule":"checkpoint-reducer","progress":["scanning*","snapshotting"],"scanCount":{"min":1,"max":65536},"result":"exact final snapshot view plus reservation checkpoint-id","successCase":"checkpoint"}
{"rule":"inspect-reducer","progress":["scanning"],"scanCount":1,"result":"exact accepted page items and next","successCase":"inspected"}
{"rule":"rollback-reducer","progress":["scanning*","rolling-back"],"sequence":"scan to EOF then apply-rollback exactly once","scanCount":{"min":1,"max":65535},"applyRollbackCount":1,"request":"the exact outer rollback-request","result":"fingerprint exact rollback-output copy","successCase":"rolled-back","priorFailureExtraEffect":0}
{"rule":"stable-errors","outer":["invalid-argument","not-found","conflict","unrollbackable","unsafe-entry","limit","unavailable","cancelled"],"hostSameNameMapping":true,"rawSourceText":false}
{"rule":"logical-charge-and-boundaries","checkedU64":true,"requestChargeMax":1048576,"resultChargeMax":1048576,"dimensions":["0","1","N","N+1"],"projections":["workspace-path bytes","path components","checkpoint-id","reservation-id","fingerprint","change hash","files","dirs","bytes","page items","snapshot","conflict paths","offset","limit","continuation"],"utf8Boundary":"whole decoded scalar, never truncation","invalidAggregate":"limit with no durable workspace mutation"}
{"rule":"stage-scope","asserts":["source and golden equality","parseable typed surface","pure path, cursor, fence, receipt, and reducer projection"],"excludes":["runtime behavior","component binary preflight","filesystem scan, checkpoint, or rollback effect"]}
