package mcode:feature-pack@0.0.1;

interface mcp-host {
    record mcp-json-document {
        root: u32,
        nodes: list<mcp-json-node>,
    }

    variant mcp-json-node {
        null,
        boolean(bool),
        number(string),
        %string(string),
        array(mcp-json-array),
        object(mcp-json-object),
    }

    record mcp-json-array {
        children: list<u32>,
    }

    record mcp-json-object {
        members: list<mcp-json-member>,
    }

    record mcp-json-member {
        key: string,
        value: u32,
    }

    record typed-invocation {
        snapshot-digest: string,
        schema-digest: string,
        server-id: string,
        tool-id: string,
        arguments: mcp-json-document,
    }

    record mcp-head {
        invocation-id: string,
        snapshot-digest: string,
        schema-digest: string,
    }

    variant mcp-exchange-output {
        text(string),
        json(mcp-json-document),
    }

    variant mcp-frame {
        head(mcp-head),
        output(mcp-exchange-output),
        failed(mcp-failure),
        end,
    }

    variant mcp-exchange-pull {
        pending,
        frame(mcp-frame),
    }

    enum mcp-failure {
        transport,
        protocol,
        timeout,
        cancelled,
    }

    enum mcp-host-error {
        invalid-argument,
        snapshot-mismatch,
        schema-mismatch,
        protocol,
        limit,
        transport-unavailable,
        cancelled,
    }

    resource mcp-exchange {
        pull: func() -> mcp-exchange-pull;
    }

    start-invoke: func(request: typed-invocation) -> result<own<mcp-exchange>, mcp-host-error>;
}

interface mcp-pack {
    use mcp-host.{mcp-json-document};

    variant mcp-request {
        servers(servers-request),
        tools(tools-request),
        invoke(invoke-request),
    }

    record servers-request {
        snapshot-digest: string,
        after: option<string>,
        limit: u16,
    }

    record tools-request {
        snapshot-digest: string,
        server-id: string,
        after: option<string>,
        limit: u16,
    }

    record invoke-request {
        snapshot-digest: string,
        schema-digest: string,
        server-id: string,
        tool-id: string,
        arguments: mcp-json-document,
    }

    enum mcp-progress {
        discovering,
        invoking,
    }

    variant mcp-pull {
        pending,
        progress(mcp-progress),
        complete(mcp-result),
        failed(mcp-error),
    }

    variant mcp-result {
        servers(server-page),
        tools(tool-page),
        invoked(mcp-output),
    }

    record server-page {
        items: list<server-info>,
        next: option<string>,
    }

    record server-info {
        server-id: string,
        title: string,
    }

    record tool-page {
        server-id: string,
        items: list<tool-info>,
        next: option<string>,
    }

    record tool-info {
        tool-id: string,
        title: string,
        description: option<string>,
        schema-digest: string,
        schema: mcp-schema-document,
    }

    variant mcp-output {
        text(string),
        json(mcp-json-document),
    }

    enum mcp-error {
        invalid-argument,
        snapshot-mismatch,
        schema-mismatch,
        server-not-found,
        tool-not-found,
        protocol,
        limit,
        transport-unavailable,
        cancelled,
    }

    record mcp-schema-document {
        root: u32,
        nodes: list<mcp-schema-node>,
    }

    variant mcp-schema-node {
        any,
        null,
        boolean,
        number(mcp-number-schema),
        %string(mcp-string-schema),
        array(mcp-array-schema),
        object(mcp-object-schema),
    }

    record mcp-number-schema {
        integer: bool,
        minimum: option<mcp-number-text>,
        maximum: option<mcp-number-text>,
    }

    record mcp-string-schema {
        min-bytes: u32,
        max-bytes: u32,
    }

    record mcp-array-schema {
        item: u32,
        min-items: u16,
        max-items: u16,
    }

    record mcp-object-schema {
        properties: list<mcp-schema-property>,
        additional: mcp-additional,
    }

    record mcp-schema-property {
        key: string,
        schema: u32,
        required: bool,
    }

    variant mcp-additional {
        forbid,
        allow-any,
        schema(u32),
    }

    type mcp-number-text = string;

    resource mcp-operation {
        pull: func() -> mcp-pull;
    }

    invoke: func(request: mcp-request) -> result<own<mcp-operation>, mcp-error>;
}

world mcp {
    import mcp-host;
    export mcp-pack;
}
