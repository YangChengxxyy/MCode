package mcode:feature-pack@0.0.1;

/// Exact Ask Host interface and family-local value types.
interface ask-host {
    variant ask-request {
        present(present-request),
    }

    record present-request {
        title: option<string>,
        questions: list<question>,
    }

    record question {
        id: string,
        header: string,
        question: string,
        kind: question-kind,
    }

    variant question-kind {
        confirm,
        text(text-params),
        single-choice(choice-params),
        multi-choice(choice-params),
    }

    record text-params {
        max-bytes: u16,
        multiline: bool,
    }

    record choice-params {
        choices: list<choice>,
    }

    record choice {
        id: string,
        label: string,
        description: string,
        preview: option<string>,
    }

    variant ask-progress {
        waiting(waiting-progress),
    }

    variant ask-pull {
        pending,
        progress(ask-progress),
        complete(ask-result),
        failed(ask-error),
    }

    record waiting-progress {
        index: u8,
        total: u8,
    }

    variant ask-result {
        answered(answers),
        abandoned,
    }

    record answers {
        items: list<answer>,
    }

    record answer {
        question-id: string,
        value: answer-value,
    }

    variant answer-value {
        confirmed(bool),
        text(string),
        choice(string),
        choices(list<string>),
    }

    enum ask-error {
        invalid-argument,
        invalid-answer,
        interaction-unavailable,
        limit,
        cancelled,
    }

    record interaction-request {
        title: option<string>,
        questions: list<question>,
    }

    variant interaction-output {
        answered(answers),
        abandoned,
    }

    enum ask-host-error {
        invalid-answer,
        interaction-unavailable,
        limit,
        cancelled,
    }

    present: func(request: interaction-request) -> result<interaction-output, ask-host-error>;
}

/// Sole-current Ask FeaturePack guest interface.
interface ask-pack {
    use ask-host.{ask-request, ask-pull, ask-error};

    resource ask-operation {
        pull: func() -> ask-pull;
    }

    invoke: func(request: ask-request) -> result<own<ask-operation>, ask-error>;
}

/// Sole-current Ask FeaturePack world.
world ask {
    import ask-host;
    export ask-pack;
}
