package mcode:feature-pack@0.0.1;

interface workspace-pack {
    variant workspace-request {
        checkpoint(checkpoint-request),
        inspect(inspect-request),
        rollback(rollback-request),
    }

    record checkpoint-request {
        reservation: checkpoint-reservation-view,
    }

    record inspect-request {
        checkpoint-id: string,
        fingerprint: string,
        offset: u32,
        limit: u16,
    }

    record rollback-request {
        checkpoint-id: string,
        expected-current: string,
        reservation: checkpoint-reservation-view,
    }

    enum workspace-progress {
        scanning,
        snapshotting,
        rolling-back,
    }

    variant workspace-pull {
        pending,
        progress(workspace-progress),
        complete(workspace-result),
        failed(workspace-error),
    }

    variant workspace-result {
        checkpoint(checkpoint-result),
        inspected(inspected-result),
        rolled-back(rolled-back-result),
    }

    record checkpoint-result {
        checkpoint-id: string,
        fingerprint: string,
        files: u64,
        dirs: u64,
        bytes: u64,
    }

    type workspace-path = string;

    record change {
        path: workspace-path,
        tracking: tracking-kind,
        kind: change-kind,
        hash: option<string>,
    }

    record inspected-result {
        items: list<change>,
        next: option<u32>,
    }

    record conflict-result {
        paths: list<workspace-path>,
        truncated: bool,
    }

    record rolled-back-result {
        fingerprint: string,
    }

    variant workspace-error {
        invalid-argument,
        not-found,
        conflict(conflict-result),
        unrollbackable,
        unsafe-entry,
        limit,
        unavailable,
        cancelled,
    }

    record scan-request {
        checkpoint-id: string,
        fingerprint: string,
        offset: u32,
        limit: u16,
    }

    record scan-page {
        items: list<change>,
        next: option<u32>,
        snapshot: workspace-snapshot-view,
    }

    record workspace-snapshot-view {
        fingerprint: string,
        files: u64,
        dirs: u64,
        bytes: u64,
    }

    record rollback-output {
        fingerprint: string,
    }

    enum tracking-kind {
        tracked,
        untracked,
        ignored,
    }

    enum change-kind {
        added,
        modified,
        deleted,
        metadata,
        unrollbackable,
    }

    record checkpoint-reservation-view {
        checkpoint-id: string,
        reservation-id: string,
        expected-current: string,
    }

    variant workspace-host-error {
        not-found,
        conflict(conflict-result),
        unrollbackable,
        unsafe-entry,
        limit,
        unavailable,
        cancelled,
    }

    resource workspace-operation {
        pull: func() -> workspace-pull;
    }

    invoke: func(request: workspace-request) -> result<own<workspace-operation>, workspace-error>;
}

interface workspace-host {
    record scan-request {
        checkpoint-id: string,
        fingerprint: string,
        offset: u32,
        limit: u16,
    }

    record scan-page {
        items: list<change>,
        next: option<u32>,
        snapshot: workspace-snapshot-view,
    }

    record rollback-request {
        checkpoint-id: string,
        expected-current: string,
        reservation: checkpoint-reservation-view,
    }

    record rollback-output {
        fingerprint: string,
    }

    variant workspace-host-error {
        not-found,
        conflict(conflict-result),
        unrollbackable,
        unsafe-entry,
        limit,
        unavailable,
        cancelled,
    }

    record change {
        path: workspace-path,
        tracking: tracking-kind,
        kind: change-kind,
        hash: option<string>,
    }

    type workspace-path = string;

    enum tracking-kind {
        tracked,
        untracked,
        ignored,
    }

    enum change-kind {
        added,
        modified,
        deleted,
        metadata,
        unrollbackable,
    }

    record workspace-snapshot-view {
        fingerprint: string,
        files: u64,
        dirs: u64,
        bytes: u64,
    }

    record checkpoint-reservation-view {
        checkpoint-id: string,
        reservation-id: string,
        expected-current: string,
    }

    record conflict-result {
        paths: list<workspace-path>,
        truncated: bool,
    }

    scan: func(request: scan-request) -> result<scan-page, workspace-host-error>;
    apply-rollback: func(request: rollback-request) -> result<rollback-output, workspace-host-error>;
}

world workspace {
    import workspace-host;
    export workspace-pack;
}
