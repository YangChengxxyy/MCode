package mcode:feature-pack@0.0.1;

interface usage-host {
    record usage-wire-document {
        root: u32,
        nodes: list<usage-wire-node>,
    }

    variant usage-wire-node {
        null,
        boolean(bool),
        number(string),
        %string(string),
        array(usage-wire-array),
        object(usage-wire-object),
    }

    record usage-wire-array {
        children: list<u32>,
    }

    record usage-wire-object {
        members: list<usage-wire-member>,
    }

    record usage-wire-member {
        key: string,
        value: u32,
    }

    enum usage-host-error {
        authority-rejected,
        protocol,
        source-unavailable,
        limit,
        cancelled,
    }

    record usage-head {
        status: u16,
        source-contract-digest: string,
        pack-generation: u64,
    }

    record usage-document-frame {
        value: usage-wire-document,
    }

    variant usage-frame {
        head(usage-head),
        document(usage-document-frame),
        failed(usage-failure),
        end,
    }

    variant usage-exchange-pull {
        pending,
        frame(usage-frame),
    }

    enum usage-failure {
        transport,
        protocol,
        timeout,
        cancelled,
    }

    resource usage-exchange {
        pull: func() -> usage-exchange-pull;
    }

    start-refresh: func() -> result<own<usage-exchange>, usage-host-error>;
}

interface usage-pack {
    use usage-host.{usage-wire-document};

    variant usage-request {
        ingest(ingest-request),
        render-summary(render-summary-request),
        render-details(render-details-request),
        refresh(refresh-request),
    }

    record ingest-request {
        source-view: usage-source-view,
        sample: usage-sample-view,
    }

    record render-summary-request {
        source-view: usage-source-view,
        state: usage-render-state-view,
    }

    record render-details-request {
        source-view: usage-source-view,
        state: usage-render-state-view,
    }

    record refresh-request {
        source-view: usage-source-view,
    }

    enum usage-progress {
        normalizing,
        refreshing,
    }

    variant usage-pull {
        pending,
        progress(usage-progress),
        complete(usage-result),
        failed(usage-error),
    }

    variant usage-result {
        ingested,
        summary(summary-result),
        details(details-result),
        refreshed,
    }

    record summary-result {
        rows: list<usage-row>,
    }

    record details-result {
        cards: list<usage-card>,
    }

    record usage-row {
        id: string,
        label: string,
        value: string,
        tone: usage-tone,
    }

    enum usage-tone {
        neutral,
        info,
        success,
        warning,
        error,
    }

    record usage-card {
        id: string,
        title: string,
        rows: list<usage-row>,
    }

    enum usage-error {
        invalid-argument,
        stale-stamp,
        duplicate-sample,
        source-unavailable,
        limit,
        cancelled,
    }

    record usage-source-view {
        source: string,
        source-stamp: string,
    }

    record usage-render-state-view {
        state-stamp: string,
        source: string,
        source-contract-digest: string,
        consumer-pack-generation: u64,
        accepted-samples: list<usage-sample-view>,
        latest-refresh: option<usage-wire-document>,
    }

    record usage-sample-view {
        source: string,
        sample-id: string,
        producer-provider: string,
        producer-route: string,
        producer-request: string,
        producer-turn: string,
        current-model: string,
        requested-model: string,
        requested-alias: option<string>,
        resolved-model: option<string>,
        counters: usage-counters,
        source-contract-digest: string,
        producer-pack-hash: string,
        producer-pack-generation: u64,
        producer-route-generation: u64,
        terminal: bool,
    }

    record usage-counters {
        input: option<u64>,
        output: option<u64>,
        cache-read: option<u64>,
        cache-write: option<u64>,
    }

    resource usage-operation {
        pull: func() -> usage-pull;
    }

    invoke: func(request: usage-request) -> result<own<usage-operation>, usage-error>;
}

world usage {
    import usage-host;
    export usage-pack;
}
