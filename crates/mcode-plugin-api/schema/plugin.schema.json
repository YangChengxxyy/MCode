{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mcode.dev/schemas/plugin/v1/plugin.schema.json",
  "title": "MCode Plugin Manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "manifestVersion",
    "id",
    "name",
    "version",
    "sdkVersion",
    "witWorld",
    "component"
  ],
  "properties": {
    "$schema": { "const": "https://mcode.dev/schemas/plugin/v1/plugin.schema.json" },
    "manifestVersion": { "const": 1 },
    "id": { "$ref": "#/$defs/pluginId" },
    "name": { "type": "string", "minLength": 1, "maxLength": 128 },
    "version": { "type": "string", "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?$" },
    "sdkVersion": { "type": "string", "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?$" },
    "witWorld": { "const": "mcode:plugin/plugin@0.1.0" },
    "component": { "$ref": "#/$defs/wasmComponentPath" },
    "imports": {
      "type": "array",
      "uniqueItems": true,
      "items": { "const": "mcode:plugin/host@0.1.0" },
      "default": []
    },
    "capabilities": {
      "type": "array",
      "maxItems": 32,
      "items": { "$ref": "#/$defs/capability" },
      "default": []
    },
    "contributions": { "$ref": "#/$defs/contributions" },
    "configSchema": { "type": "object" },
    "state": { "$ref": "#/$defs/state" }
  },
  "$defs": {
    "pluginId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[a-z](?:[a-z0-9._-]*[a-z0-9])?$"
    },
    "identifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 96,
      "pattern": "^[a-z](?:[a-z0-9._-]*[a-z0-9])?$"
    },
    "relativePath": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\).+$"
    },
    "wasmComponentPath": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\).+\\.wasm$"
    },
    "capability": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "access", "roots"],
          "properties": {
            "kind": { "const": "filesystem" },
            "access": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "enum": ["read", "write"] } },
            "roots": { "type": "array", "minItems": 1, "maxItems": 128, "uniqueItems": true, "items": { "$ref": "#/$defs/relativePath" } }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "hosts"],
          "properties": {
            "kind": { "const": "network" },
            "hosts": { "type": "array", "minItems": 1, "maxItems": 128, "uniqueItems": true, "items": { "type": "string" } }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "names"],
          "properties": {
            "kind": { "const": "secrets" },
            "names": { "type": "array", "minItems": 1, "maxItems": 128, "uniqueItems": true, "items": { "$ref": "#/$defs/identifier" } }
          }
        },
        { "type": "object", "additionalProperties": false, "required": ["kind"], "properties": { "kind": { "const": "sessionState" } } },
        { "type": "object", "additionalProperties": false, "required": ["kind"], "properties": { "kind": { "const": "ui" } } },
        { "type": "object", "additionalProperties": false, "required": ["kind"], "properties": { "kind": { "const": "promptContribution" } } }
      ]
    },
    "contributions": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "tools": { "type": "array", "maxItems": 128, "items": { "$ref": "#/$defs/tool" }, "default": [] },
        "commands": { "type": "array", "maxItems": 128, "items": { "$ref": "#/$defs/command" }, "default": [] },
        "prompts": { "type": "array", "maxItems": 128, "items": { "$ref": "#/$defs/prompt" }, "default": [] },
        "resources": { "type": "array", "maxItems": 128, "items": { "$ref": "#/$defs/resource" }, "default": [] },
        "views": { "type": "array", "maxItems": 128, "items": { "$ref": "#/$defs/uiContribution" }, "default": [] },
        "timelines": { "type": "array", "maxItems": 128, "items": { "$ref": "#/$defs/uiContribution" }, "default": [] },
        "modals": { "type": "array", "maxItems": 128, "items": { "$ref": "#/$defs/uiContribution" }, "default": [] },
        "widgets": { "type": "array", "maxItems": 128, "items": { "$ref": "#/$defs/uiContribution" }, "default": [] },
        "eventSubscriptions": { "type": "array", "maxItems": 128, "items": { "$ref": "#/$defs/eventSubscription" }, "default": [] }
      },
      "default": {}
    },
    "tool": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "displayName", "description", "inputSchema"],
      "properties": {
        "id": { "$ref": "#/$defs/identifier" },
        "name": { "$ref": "#/$defs/identifier" },
        "displayName": { "type": "string" },
        "description": { "type": "string" },
        "inputSchema": { "type": "object" },
        "outputSchema": { "type": "object" },
        "requiredCapabilities": { "type": "array", "uniqueItems": true, "items": { "enum": ["filesystem", "network", "secrets", "sessionState", "ui", "promptContribution"] }, "default": [] }
      }
    },
    "command": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "title", "description"],
      "properties": {
        "id": { "$ref": "#/$defs/identifier" },
        "name": { "$ref": "#/$defs/identifier" },
        "title": { "type": "string" },
        "description": { "type": "string" }
      }
    },
    "prompt": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "priority", "maxBytes"],
      "properties": {
        "id": { "$ref": "#/$defs/identifier" },
        "priority": { "type": "integer", "minimum": -32768, "maximum": 32767 },
        "maxBytes": { "type": "integer", "minimum": 1, "maximum": 16384 }
      }
    },
    "resource": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "path"],
      "properties": {
        "id": { "$ref": "#/$defs/identifier" },
        "kind": { "enum": ["skill", "prompt", "theme", "agent", "data"] },
        "path": { "$ref": "#/$defs/relativePath" }
      }
    },
    "viewMetadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "region", "priority", "width", "invalidation"],
      "properties": {
        "id": { "$ref": "#/$defs/identifier" },
        "region": { "enum": ["global", "timeline", "composer", "sidebar", "overlay"] },
        "priority": { "type": "integer", "minimum": -32768, "maximum": 32767 },
        "width": {
          "type": "object",
          "additionalProperties": false,
          "required": ["min", "max"],
          "properties": { "min": { "type": "integer", "minimum": 1, "maximum": 4096 }, "max": { "type": "integer", "minimum": 1, "maximum": 4096 } }
        },
        "invalidation": {
          "oneOf": [
            { "type": "object", "additionalProperties": false, "required": ["mode"], "properties": { "mode": { "const": "manual" } } },
            { "type": "object", "additionalProperties": false, "required": ["mode", "events"], "properties": { "mode": { "const": "onEvents" }, "events": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "enum": ["model", "stream", "usage", "tool", "network"] } } } },
            { "type": "object", "additionalProperties": false, "required": ["mode", "intervalMs"], "properties": { "mode": { "const": "interval" }, "intervalMs": { "type": "integer", "minimum": 16, "maximum": 86400000 } } }
          ]
        }
      }
    },
    "uiContribution": {
      "type": "object",
      "additionalProperties": false,
      "required": ["metadata", "description"],
      "properties": { "metadata": { "$ref": "#/$defs/viewMetadata" }, "description": { "type": "string" } }
    },
    "eventSubscription": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "events", "mailboxCapacity"],
      "properties": {
        "id": { "$ref": "#/$defs/identifier" },
        "events": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "enum": ["model", "stream", "usage", "tool", "network"] } },
        "mailboxCapacity": { "type": "integer", "minimum": 1, "maximum": 1024 }
      }
    },
    "state": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "portable": { "type": "array", "maxItems": 64, "items": { "$ref": "#/$defs/portableState" }, "default": [] },
        "secret": { "type": "array", "maxItems": 64, "items": { "$ref": "#/$defs/secretState" }, "default": [] }
      },
      "default": {}
    },
    "portableState": {
      "type": "object",
      "additionalProperties": false,
      "required": ["key", "version", "maxBytes"],
      "properties": {
        "key": { "$ref": "#/$defs/identifier" },
        "version": { "type": "integer", "minimum": 1 },
        "maxBytes": { "type": "integer", "minimum": 1, "maximum": 65536 }
      }
    },
    "secretState": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "purpose"],
      "properties": {
        "name": { "$ref": "#/$defs/identifier" },
        "purpose": { "type": "string", "minLength": 1, "maxLength": 512 }
      }
    }
  }
}
